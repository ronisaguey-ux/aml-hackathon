[Unit]
Description=AxiomMem Tunnel Controller (Named Tunnel Ingress on axiom.helpotron.dpdns.org)
After=helpotron-tunnel.service
Wants=helpotron-tunnel.service

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl --user restart helpotron-tunnel.service
RemainAfterExit=yes

[Install]
WantedBy=default.target
